# ফাইলত লিখা আৰু পঢ়া
ফাইল* f = খোলা("asomiya_demo.txt", "w")
যদি f == খালি থাকিলে
    লিখা "ফাইল খুলিব নোৱাৰি"
    প্ৰস্থান(১)
শেষ
প্ৰতিবাৰ i = ১ লৈকে ৩
    ফাইলত_ছপা(f, "শাৰী %d\n", i)
শেষ
বন্ধ(f)

f = খোলা("asomiya_demo.txt", "r")
বাক্য শাৰী = ফাইলৰ_শাৰী(f)
পূৰ্ণ গণক = ০
যেতিয়া শাৰী != খালি
    গণক++
    লিখা গণক, ":", শাৰী
    মুকলি(শাৰী)
    শাৰী = ফাইলৰ_শাৰী(f)
শেষ
বন্ধ(f)
