# তালিকা (array): এক আৰু দুই মাত্ৰা
পূৰ্ণ[] মান = [৫, ২, ৯, ১, ৭]
লিখা "মূল:", মান
পূৰ্ণ n = দৈৰ্ঘ্য(মান)
প্ৰতিবাৰ i = ১ লৈকে n - ১          # insertion sort
    পূৰ্ণ চাবি = মান[i]
    পূৰ্ণ j = i - ১
    যেতিয়া j >= ০ আৰু মান[j] > চাবি
        মান[j + ১] = মান[j]
        j--
    শেষ
    মান[j + ১] = চাবি
শেষ
লিখা "সজোৱা:", মান

# ২×৩ আৰু ৩×২ matrix-ৰ পূৰণ
পূৰ্ণ[২][৩] ক = [[১, ২, ৩], [৪, ৫, ৬]]
পূৰ্ণ[৩][২] খ = [[৭, ৮], [৯, ১০], [১১, ১২]]
পূৰ্ণ[২][২] গ
প্ৰতিবাৰ r = ০ লৈকে ১
    প্ৰতিবাৰ c = ০ লৈকে ১
        প্ৰতিবাৰ k = ০ লৈকে ২
            গ[r][c] += ক[r][k] * খ[k][c]
        শেষ
    শেষ
শেষ
লিখা "পূৰণফল:", গ

বাক্য[] ফল = ["আম", "কল", "লিচু", "কমলা"]
প্ৰতিবাৰ i = ০ লৈকে দৈৰ্ঘ্য(ফল) - ১
    লিখা i + ১, ফল[i]
শেষ
